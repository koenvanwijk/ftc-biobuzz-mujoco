  <block type="procedures_defnoreturn" id="fc915" x="3300" y="700">
    <field name="NAME">leaveHive</field>
    <comment pinned="false" h="140" w="560">Rij van de HIVE weg naar de gang x = -1,0.</comment>
    <statement name="STACK">
      <block type="comment" id="fc900">
        <field name="COMMENT">Staat de robot bij de HIVE (bv. op een schietplek)? Eerst terug naar de gang x = -1,0 op y = ±1,2: weg van de palen van de wip (x = -0,6) en van de FLOWER-kraag bij de muur.</field>
        <next>
          <block type="controls_if" id="fc914">
            <value name="IF0">
              <block type="logic_compare" id="fc903">
                <field name="OP">GT</field>
                <value name="A">
                  <block type="variables_get" id="fc901">
                    <field name="VAR" id="v_robotX">robotX</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="fc902">
                    <field name="NUM">-1.0</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="fc913">
                <mutation else="1"/>
                <value name="IF0">
                  <block type="logic_compare" id="fc906">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="variables_get" id="fc904">
                        <field name="VAR" id="v_robotY">robotY</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="fc905">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="procedures_callnoreturn" id="fc909">
                    <mutation name="goTo">
                      <arg name="gx"/>
                      <arg name="gy"/>
                    </mutation>
                    <value name="ARG0">
                      <block type="math_number" id="fc907">
                        <field name="NUM">-1.0</field>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="math_number" id="fc908">
                        <field name="NUM">1.2</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="procedures_callnoreturn" id="fc912">
                    <mutation name="goTo">
                      <arg name="gx"/>
                      <arg name="gy"/>
                    </mutation>
                    <value name="ARG0">
                      <block type="math_number" id="fc910">
                        <field name="NUM">-1.0</field>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="math_number" id="fc911">
                        <field name="NUM">-1.2</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" id="fc964" x="3300" y="400">
    <mutation>
      <arg name="px" varid="v_px"/>
      <arg name="py" varid="v_py"/>
      <arg name="pHeading" varid="v_pHeading"/>
      <arg name="backM" varid="v_backM"/>
    </mutation>
    <field name="NAME">collectAt</field>
    <comment pinned="false" h="140" w="560">Oppakken op een bekende plek: rij naar (px, py), draai naar pHeading (achterkant naar de ballen), intake aan, backM meter achteruit, 20 graden links/rechts zwaaien en 15 cm terug. Geen kleurdetectie: wat er werkelijk in zit kan het programma niet meten (geen sensor), dus de robot schiet daarna gewoon 4 keer.</comment>
    <statement name="STACK">
      <block type="comment" id="fc916">
        <field name="COMMENT">Geen camera nodig: de gele POLLEN liggen op een bekende plek. De robot rijdt naar het startpunt (px, py), draait zo dat de ACHTERKANT (intake) naar de ballen wijst en rijdt dan achteruit met de intake aan.</field>
        <next>
          <block type="procedures_callnoreturn" id="fc917">
            <mutation name="leaveHive"/>
            <next>
              <block type="comment" id="fc918">
                <field name="COMMENT">Na het schieten is de positie bekend (localize op de schietplek), dus geen tussenstop om te localizen: via de gang x = -1,0 direct naar de ballen.</field>
                <next>
                  <block type="procedures_callnoreturn" id="fc925">
                            <mutation name="goTo">
                              <arg name="gx"/>
                              <arg name="gy"/>
                            </mutation>
                            <value name="ARG0">
                              <block type="math_number" id="fc923">
                                <field name="NUM">-1.0</field>
                              </block>
                            </value>
                            <value name="ARG1">
                              <block type="variables_get" id="fc924">
                                <field name="VAR" id="v_py">py</field>
                              </block>
                            </value>
                            <next>
                              <block type="procedures_callnoreturn" id="fc928">
                                <mutation name="goTo">
                                  <arg name="gx"/>
                                  <arg name="gy"/>
                                </mutation>
                                <value name="ARG0">
                                  <block type="variables_get" id="fc926">
                                    <field name="VAR" id="v_px">px</field>
                                  </block>
                                </value>
                                <value name="ARG1">
                                  <block type="variables_get" id="fc927">
                                    <field name="VAR" id="v_py">py</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="procedures_callnoreturn" id="fc930">
                                    <mutation name="turnToHeading">
                                      <arg name="targetHeading"/>
                                    </mutation>
                                    <value name="ARG0">
                                      <block type="variables_get" id="fc929">
                                        <field name="VAR" id="v_pHeading">pHeading</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="telemetry_addTextData_All" id="fc933">
                                        <value name="KEY">
                                          <block type="text" id="fc932">
                                            <field name="TEXT">Fase</field>
                                          </block>
                                        </value>
                                        <value name="TEXT">
                                          <block type="text" id="fc931">
                                            <field name="TEXT">Gele POLLEN oppakken (achterintake)</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="procedures_callnoreturn" id="rc31"><mutation name="showTime"></mutation><next><block type="telemetry_update" id="fc934">
                                            <next>
                                              <block type="dcMotor_setProperty_Number" id="fc935">
                                                <field name="IDENTIFIER">intakeMotorAsDcMotor</field>
                                                <field name="PROP">Power</field>
                                                <data>{"IDENTIFIER":"intakeMotor"}</data>
                                                <value name="VALUE">
                                                  <block type="math_number" id="fc936">
                                                    <field name="NUM">1</field>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="procedures_callnoreturn" id="rc36"><mutation name="rearCollect"><arg name="rcHeading"></arg><arg name="rcBackM"></arg></mutation><value name="ARG0"><block type="variables_get" id="rc37"><field name="VAR" id="v_pHeading">pHeading</field></block></value><value name="ARG1"><block type="variables_get" id="rc38"><field name="VAR" id="v_backM">backM</field></block></value><next><block type="procedures_callnoreturn" id="fc940">
