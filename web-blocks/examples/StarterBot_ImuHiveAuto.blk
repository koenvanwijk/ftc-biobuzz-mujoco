                    <field name="VAR" id="v_angle">angle</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="y5020">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="math_trig" id="y5018">
                            <field name="OP">ATAN</field>
                            <value name="NUM">
                              <block type="math_arithmetic" id="y5017">
                                <field name="OP">DIVIDE</field>
                                <value name="A">
                                  <block type="variables_get" id="y5015">
                                    <field name="VAR" id="v_ay">ay</field>
                                  </block>
                                </value>
