        <field name="VAR" id="v_shots">shots</field>
        <value name="VALUE">
          <block type="math_number" id="b452">
            <field name="NUM">0</field>
          </block>
        </value>
        <next>
          <block type="controls_if" id="gate_if"><mutation else="1"/><comment pinned="false" h="80" w="460">Alleen schieten als de laatste localize de tags van de HIVE zag (found). Anders staat de robot misschien op de verkeerde plek: niet schieten.</comment><value name="IF0"><block type="variables_get" id="gate_found"><field name="VAR" id="v_found">found</field></block></value><statement name="DO0"><block type="controls_whileUntil" id="b479">
