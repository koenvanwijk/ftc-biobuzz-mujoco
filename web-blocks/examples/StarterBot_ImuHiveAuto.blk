                        <field name="VAR" id="v_ax">ax</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_if" id="y5038">
            <mutation else="1"/>
            <value name="IF0">
              <block type="logic_compare" id="y5011">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="variables_get" id="y5009">
                    <field name="VAR" id="v_ax">ax</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="y5010">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="y5029">
                <mutation else="1"/>
                <value name="IF0">
                  <block type="logic_compare" id="y5014">
                    <field name="OP">GTE</field>
