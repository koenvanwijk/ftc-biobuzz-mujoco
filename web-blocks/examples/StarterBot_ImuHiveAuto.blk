                    <value name="IF0">
                      <block type="variables_get" id="fc233">
                        <field name="VAR" id="v_found">found</field>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="procedures_callnoreturn" id="fc234">
                        <mutation name="readHeading"/>
                        <next>
                          <block type="comment" id="fc235">
                            <field name="COMMENT">Liggende camera (landscape) aan de voorkant: ftcPose.x = rechts (dus links = -x), ftcPose.y = vooruit langs de lens, ftcPose.z = omhoog. De lens kijkt CAMERA_PITCH_DEG omhoog: reken terug naar de vloer.</field>
                            <next>
                              <block type="variables_set" id="fc245">
