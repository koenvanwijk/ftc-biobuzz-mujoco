  <block type="procedures_defnoreturn" id="fc899" x="2500" y="-400">
    <field name="NAME">goToShootingSpot</field>
    <comment pinned="false" h="140" w="560">Rij naar de schietplek recht voor de opening van de omhoog-CELL (in het verlengde van de wip, SHOOT_DISTANCE_M ervoor) en richt de voorkant (shooter) erop. Positie met de AprilTags (liggende camera aan de voorkant) en odometrie.</comment>
    <statement name="STACK">
      <block type="comment" id="fc671">
        <field name="COMMENT">De opening van RED AUDIENCE (y &lt; 0) wijst naar -y, die van RED SCORING (na de TIP) naar +y. De shooter zit aan de VOORKANT: de robot kijkt recht in de opening.</field>
        <next>
          <block type="controls_if" id="fc679">
            <mutation else="1"/>
            <value name="IF0">
              <block type="logic_compare" id="fc674">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="variables_get" id="fc672">
                    <field name="VAR" id="v_CELL_Y">CELL_Y</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="fc673">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="fc676">
                <field name="VAR" id="v_SHOOT_HEADING">SHOOT_HEADING</field>
                <value name="VALUE">
                  <block type="math_number" id="fc675">
                    <field name="NUM">90</field>
                  </block>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="fc678">
                <field name="VAR" id="v_SHOOT_HEADING">SHOOT_HEADING</field>
                <value name="VALUE">
                  <block type="math_number" id="fc677">
                    <field name="NUM">-90</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="comment" id="fc680">
                <field name="COMMENT">Schietplek in het verlengde van de wip: SHOOT_DISTANCE_M recht voor de opening (zelfde x als de CELL).</field>
                <next>
                  <block type="variables_set" id="fc687">
                    <field name="VAR" id="v_goalX">goalX</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="fc686">
                        <field name="OP">MINUS</field>
                        <value name="A">
                          <block type="variables_get" id="fc681">
                            <field name="VAR" id="v_CELL_X">CELL_X</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_arithmetic" id="fc685">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="fc682">
                                <field name="VAR" id="v_SHOOT_DISTANCE_M">SHOOT_DISTANCE_M</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_trig" id="fc684">
                                <field name="OP">COS</field>
                                <value name="NUM">
                                  <block type="variables_get" id="fc683">
                                    <field name="VAR" id="v_SHOOT_HEADING">SHOOT_HEADING</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="fc694">
                        <field name="VAR" id="v_goalY">goalY</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="fc693">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <block type="variables_get" id="fc688">
                                <field name="VAR" id="v_CELL_Y">CELL_Y</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_arithmetic" id="fc692">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="fc689">
                                    <field name="VAR" id="v_SHOOT_DISTANCE_M">SHOOT_DISTANCE_M</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_trig" id="fc691">
                                    <field name="OP">SIN</field>
                                    <value name="NUM">
                                      <block type="variables_get" id="fc690">
                                        <field name="VAR" id="v_SHOOT_HEADING">SHOOT_HEADING</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="comment" id="fc695">
                            <field name="COMMENT">Geen extra positiecheck onderweg: de startpositie (A6) en de HIVE-stand bij de start zijn bekend, en na het schieten weet de robot zijn positie nog (laatste localize op de schietplek). Odometrie tot de schietplek; daar pas de tags.</field>
                            <next>
                              <block type="comment" id="fc699">
                                        <field name="COMMENT">Dan altijd via de gang x = -1,0 (ruim langs de palen van de wip, x = -0,6) en het tussenpunt y = ±1,2 naar de schietplek. Zo blijft de robot ook weg van de FLOWER-kraag bij de muur (y = ±1,73).</field>
                                        <next>
