  <block type="procedures_defnoreturn" id="run1" deletable="false" x="20" y="20">
    <field name="NAME">runOpMode</field>
    <comment pinned="false" h="140" w="560">Autonoom ImuHiveAuto (BIOBUZZ, rood, start A6). 1) Rijdt rechtuit met IMU-koers (P-correctie op yaw). 2) Draait met de IMU naar de HIVE (richting 90 graden). 3) Lijnt uit met de AprilTag-cluster RED SCORING (tags 30-33): recht ervoor op 1,20 m horizontale afstand (camera tot CELL-opening). Portret-camera, 17,5 graden omhoog: ftcPose.x = omhoog, ftcPose.y = langs de lens, ftcPose.z = links; daaruit de horizontale afstand en hoek.</comment>
    <statement name="STACK">
      <block type="comment" id="b363">
        <field name="COMMENT">Autonoom (rood, start A6): rij met IMU-koers, draai met de IMU naar de HIVE en lijn uit met de AprilTags.</field>
        <next>
          <block type="variables_set" id="b365">
            <field name="VAR" id="v_TICKS_PER_METER">TICKS_PER_METER</field>
            <value name="VALUE">
              <block type="math_number" id="b364">
                <field name="NUM">2200</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="b367">
                <field name="VAR" id="v_TARGET_RANGE_M">TARGET_RANGE_M</field>
                <value name="VALUE">
                  <block type="math_number" id="b366">
                    <field name="NUM">1.2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="b369">
                    <field name="VAR" id="v_HIVE_HEADING">HIVE_HEADING</field>
                    <value name="VALUE">
                      <block type="math_number" id="b368">
                        <field name="NUM">90</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="b371">
                        <field name="VAR" id="v_CAMERA_PITCH_DEG">CAMERA_PITCH_DEG</field>
                        <value name="VALUE">
                          <block type="math_number" id="b370">
                            <field name="NUM">17.5</field>
                          </block>
                        </value>
                        <next>
                          <block type="dcMotor_setProperty_Direction" id="b372">
                            <field name="IDENTIFIER">leftDriveAsDcMotor</field>
                            <field name="PROP">Direction</field>
                            <data>{"IDENTIFIER":"leftDrive"}</data>
                            <value name="VALUE">
                              <shadow type="dcMotor_typedEnum_direction">
                                <field name="DIRECTION">REVERSE</field>
                              </shadow>
                            </value>
                            <next>
                              <block type="dcMotor_setProperty_Direction" id="b373">
                                <field name="IDENTIFIER">rightDriveAsDcMotor</field>
                                <field name="PROP">Direction</field>
                                <data>{"IDENTIFIER":"rightDrive"}</data>
                                <value name="VALUE">
                                  <shadow type="dcMotor_typedEnum_direction">
                                    <field name="DIRECTION">FORWARD</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="imu_initialize" id="b378">
                                    <field name="IDENTIFIER">imuAsIMU</field>
                                    <value name="PARAMETERS">
                                      <block type="imuParameters_create" id="b377">
                                        <value name="IMU_ORIENTATION_ON_ROBOT">
                                          <block type="revHubOrientationOnRobot_create1" id="b376">
                                            <value name="LOGO_FACING_DIRECTION">
                                              <block type="revHubOrientationOnRobot_typedEnum_logoFacingDirection" id="b374">
                                                <field name="LOGO_FACING_DIRECTION">UP</field>
                                              </block>
                                            </value>
                                            <value name="USB_FACING_DIRECTION">
                                              <block type="revHubOrientationOnRobot_typedEnum_usbFacingDirection" id="b375">
                                                <field name="USB_FACING_DIRECTION">FORWARD</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="b380">
                                        <field name="VAR" id="v_myAprilTagProcessor">myAprilTagProcessor</field>
                                        <value name="VALUE">
                                          <block type="aprilTagProcessor_easyCreateWithDefaults" id="b379"/>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="b384">
                                            <field name="VAR" id="v_myVisionPortal">myVisionPortal</field>
                                            <value name="VALUE">
                                              <block type="visionPortal_easyCreateWithDefaults_oneProcessor" id="b383">
                                                <value name="CAMERA">
                                                  <block type="navigation_webcamName" id="b381">
                                                    <field name="WEBCAM_NAME">Webcam 1</field>
                                                  </block>
                                                </value>
                                                <value name="VISION_PROCESSOR">
                                                  <block type="variables_get" id="b382">
                                                    <field name="VAR" id="v_myAprilTagProcessor">myAprilTagProcessor</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="telemetry_addTextData_All" id="b387">
                                                <value name="KEY">
                                                  <block type="text" id="b386">
                                                    <field name="TEXT">Status</field>
                                                  </block>
                                                </value>
                                                <value name="TEXT">
                                                  <block type="text" id="b385">
                                                    <field name="TEXT">Klaar. Druk op START.</field>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="telemetry_update" id="b388">
                                                    <next>
                                                      <block type="linearOpMode_waitForStart" id="b389">
                                                        <next>
                                                          <block type="imu_resetYaw" id="b390">
                                                            <field name="IDENTIFIER">imuAsIMU</field>
                                                            <next>
                                                              <block type="comment" id="b391">
                                                                <field name="COMMENT">1) IMU: los van de muur, rechtsaf langs de rode muur, linksaf onder de HIVE door.</field>
                                                                <next>
                                                                  <block type="procedures_callnoreturn" id="b395">
                                                                    <mutation name="driveStraight">
                                                                      <arg name="meters"/>
                                                                      <arg name="targetHeading"/>
                                                                      <arg name="maxPower"/>
                                                                    </mutation>
                                                                    <value name="ARG0">
                                                                      <block type="math_number" id="b392">
                                                                        <field name="NUM">0.3</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="ARG1">
                                                                      <block type="math_number" id="b393">
                                                                        <field name="NUM">0</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="ARG2">
                                                                      <block type="math_number" id="b394">
                                                                        <field name="NUM">0.5</field>
                                                                      </block>
                                                                    </value>
                                                                    <next>
                                                                      <block type="procedures_callnoreturn" id="b397">
                                                                        <mutation name="turnToHeading">
                                                                          <arg name="targetHeading"/>
                                                                        </mutation>
                                                                        <value name="ARG0">
                                                                          <block type="math_number" id="b396">
                                                                            <field name="NUM">-90</field>
                                                                          </block>
                                                                        </value>
                                                                        <next>
                                                                          <block type="procedures_callnoreturn" id="b401">
                                                                            <mutation name="driveStraight">
                                                                              <arg name="meters"/>
                                                                              <arg name="targetHeading"/>
                                                                              <arg name="maxPower"/>
                                                                            </mutation>
                                                                            <value name="ARG0">
                                                                              <block type="math_number" id="b398">
                                                                                <field name="NUM">2.3</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="ARG1">
                                                                              <block type="math_number" id="b399">
                                                                                <field name="NUM">-90</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="ARG2">
                                                                              <block type="math_number" id="b400">
                                                                                <field name="NUM">0.6</field>
                                                                              </block>
                                                                            </value>
                                                                            <next>
                                                                              <block type="procedures_callnoreturn" id="b403">
                                                                                <mutation name="turnToHeading">
                                                                                  <arg name="targetHeading"/>
                                                                                </mutation>
                                                                                <value name="ARG0">
                                                                                  <block type="math_number" id="b402">
                                                                                    <field name="NUM">0</field>
                                                                                  </block>
                                                                                </value>
                                                                                <next>
                                                                                  <block type="procedures_callnoreturn" id="b407">
                                                                                    <mutation name="driveStraight">
                                                                                      <arg name="meters"/>
                                                                                      <arg name="targetHeading"/>
                                                                                      <arg name="maxPower"/>
                                                                                    </mutation>
                                                                                    <value name="ARG0">
                                                                                      <block type="math_number" id="b404">
                                                                                        <field name="NUM">0.65</field>
                                                                                      </block>
                                                                                    </value>
                                                                                    <value name="ARG1">
                                                                                      <block type="math_number" id="b405">
                                                                                        <field name="NUM">0</field>
                                                                                      </block>
                                                                                    </value>
                                                                                    <value name="ARG2">
                                                                                      <block type="math_number" id="b406">
                                                                                        <field name="NUM">0.5</field>
                                                                                      </block>
                                                                                    </value>
                                                                                    <next>
                                                                                      <block type="comment" id="b408">
                                                                                        <field name="COMMENT">2) IMU: draai naar de HIVE.</field>
                                                                                        <next>
                                                                                          <block type="procedures_callnoreturn" id="b410">
                                                                                            <mutation name="turnToHeading">
                                                                                              <arg name="targetHeading"/>
                                                                                            </mutation>
                                                                                            <value name="ARG0">
                                                                                              <block type="variables_get" id="b409">
                                                                                                <field name="VAR" id="v_HIVE_HEADING">HIVE_HEADING</field>
                                                                                              </block>
                                                                                            </value>
                                                                                            <next>
                                                                                              <block type="comment" id="b411">
                                                                                                <field name="COMMENT">3) AprilTag: recht voor de RED SCORING CELL op de juiste afstand.</field>
                                                                                                <next>
                                                                                                  <block type="procedures_callnoreturn" id="b412">
                                                                                                    <mutation name="squareUpToHive"/>
                                                                                                    <next>
                                                                                                      <block type="controls_whileUntil" id="b432">
                                                                                                        <field name="MODE">WHILE</field>
                                                                                                        <value name="BOOL">
                                                                                                          <block type="linearOpMode_opModeIsActive" id="b413"/>
                                                                                                        </value>
                                                                                                        <statement name="DO">
                                                                                                          <block type="telemetry_addTextData_All" id="b416">
                                                                                                            <value name="KEY">
                                                                                                              <block type="text" id="b415">
                                                                                                                <field name="TEXT">Fase</field>
                                                                                                              </block>
                                                                                                            </value>
                                                                                                            <value name="TEXT">
                                                                                                              <block type="text" id="b414">
                                                                                                                <field name="TEXT">Klaar</field>
                                                                                                              </block>
                                                                                                            </value>
                                                                                                            <next>
                                                                                                              <block type="telemetry_addTextData_All" id="b419">
                                                                                                                <value name="KEY">
                                                                                                                  <block type="text" id="b418">
                                                                                                                    <field name="TEXT">Uitgelijnd</field>
                                                                                                                  </block>
                                                                                                                </value>
                                                                                                                <value name="TEXT">
                                                                                                                  <block type="variables_get" id="b417">
                                                                                                                    <field name="VAR" id="v_aligned">aligned</field>
                                                                                                                  </block>
                                                                                                                </value>
                                                                                                                <next>
                                                                                                                  <block type="telemetry_addNumericData_Number" id="b422">
                                                                                                                    <value name="KEY">
                                                                                                                      <block type="text" id="b421">
                                                                                                                        <field name="TEXT">Afstand tot CELL (m)</field>
                                                                                                                      </block>
                                                                                                                    </value>
                                                                                                                    <value name="NUMBER">
                                                                                                                      <block type="variables_get" id="b420">
                                                                                                                        <field name="VAR" id="v_rangeH">rangeH</field>
                                                                                                                      </block>
                                                                                                                    </value>
                                                                                                                    <next>
                                                                                                                      <block type="telemetry_addNumericData_Number" id="b425">
                                                                                                                        <value name="KEY">
                                                                                                                          <block type="text" id="b424">
                                                                                                                            <field name="TEXT">Hoek naar CELL (gr)</field>
                                                                                                                          </block>
                                                                                                                        </value>
                                                                                                                        <value name="NUMBER">
                                                                                                                          <block type="variables_get" id="b423">
                                                                                                                            <field name="VAR" id="v_bearingH">bearingH</field>
                                                                                                                          </block>
                                                                                                                        </value>
                                                                                                                        <next>
                                                                                                                          <block type="telemetry_addNumericData_Number" id="b428">
                                                                                                                            <value name="KEY">
                                                                                                                              <block type="text" id="b427">
                                                                                                                                <field name="TEXT">Scheefstand t.o.v. HIVE (gr)</field>
                                                                                                                              </block>
                                                                                                                            </value>
                                                                                                                            <value name="NUMBER">
                                                                                                                              <block type="variables_get" id="b426">
                                                                                                                                <field name="VAR" id="v_skew">skew</field>
                                                                                                                              </block>
                                                                                                                            </value>
                                                                                                                            <next>
                                                                                                                              <block type="telemetry_update" id="b429">
                                                                                                                                <next>
                                                                                                                                  <block type="linearOpMode_sleep" id="b431">
