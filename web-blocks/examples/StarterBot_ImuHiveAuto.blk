                                                                            </next>
                                                                          </block>
                                                                        </next>
                                                                      </block></next></block>
                                                                    </next>
                                                                  </block>
                                                                </statement>
                                                                <next>
                                                                  <block type="controls_if" id="fc1020">
                                                                    <mutation else="1"/>
                                                                    <value name="IF0">
                                                                      <block type="variables_get" id="fc1003">
                                                                        <field name="VAR" id="v_cellSure">cellSure</field>
                                                                      </block>
                                                                    </value>
                                                                    <statement name="DO0">
                                                                      <block type="telemetry_addTextData_All" id="fc1006">
                                                                        <value name="KEY">
                                                                          <block type="text" id="fc1005">
                                                                            <field name="TEXT">Fase</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="TEXT">
                                                                          <block type="text" id="fc1004">
                                                                            <field name="TEXT">Schieten (ronde)</field>
                                                                          </block>
                                                                        </value>
                                                                        <next>
                                                                          <block type="telemetry_addNumericData_Number" id="fc1009">
                                                                            <value name="KEY">
                                                                              <block type="text" id="fc1008">
                                                                                <field name="TEXT">Ronde</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="NUMBER">
