                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="fc196">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set" id="fc202">
                    <field name="VAR" id="v_detections">detections</field>
                    <value name="VALUE">
                      <block type="aprilTagProcessor_getDetections" id="fc201">
