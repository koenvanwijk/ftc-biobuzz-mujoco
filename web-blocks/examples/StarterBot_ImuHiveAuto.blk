  <block type="procedures_defnoreturn" id="y6113" x="2500" y="1700"><field name="NAME">scanForYellow</field><comment pinned="false" h="120" w="520">Draai in stappen van 45 graden tot de camera een bereikbare gele bal op de vloer ziet (blob onderin beeld, beeld-X &lt; 250, niet richting de HIVE-palen). Max 8 stappen (rondje).</comment><statement name="STACK"><block type="variables_set" id="y6051"><field name="VAR" id="v_yellowFound">yellowFound</field><value name="VALUE"><block type="logic_boolean" id="y6050"><field name="BOOL">FALSE</field></block></value><next><block type="variables_set" id="y6053"><field name="VAR" id="v_scanStep">scanStep</field><value name="VALUE"><block type="math_number" id="y6052"><field name="NUM">0</field></block></value><next><block type="controls_whileUntil" id="y6112"><field name="MODE">WHILE</field><value name="BOOL"><block type="logic_operation" id="y6061"><field name="OP">AND</field><value name="A"><block type="linearOpMode_opModeIsActive" id="y6054" /></value><value name="B"><block type="logic_operation" id="y6060"><field name="OP">AND</field><value name="A"><block type="logic_negate" id="y6056"><value name="BOOL"><block type="variables_get" id="y6055"><field name="VAR" id="v_yellowFound">yellowFound</field></block></value></block></value><value name="B"><block type="logic_compare" id="y6059"><field name="OP">LT</field><value name="A"><block type="variables_get" id="y6057"><field name="VAR" id="v_scanStep">scanStep</field></block></value><value name="B"><block type="math_number" id="y6058"><field name="NUM">8</field></block></value></block></value></block></value></block></value><statement name="DO"><block type="linearOpMode_sleep" id="y6063"><value name="MILLISECONDS"><block type="math_number" id="y6062"><field name="NUM">300</field></block></value><next><block type="variables_set" id="y6066"><field name="VAR" id="v_blobs">blobs</field><value name="VALUE"><block type="colorBlobLocatorProcessor_getBlobs" id="y6065"><value name="COLOR