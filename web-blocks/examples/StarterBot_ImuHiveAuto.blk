  <block type="procedures_defnoreturn" id="fc1021" x="2500" y="1400">
    <field name="NAME">shootRound</field>
    <comment pinned="false" h="140" w="560">Eén schietronde: met de bekende stand van de HIVE direct naar de schietplek van de omhoog-CELL (voorkant = shooter naar de opening). Daar, vlak voor het schieten, positie (tags) en CELL controleren; alleen schieten als het zeker is en de tags gezien zijn.</comment>
    <statement name="STACK">
      <block type="comment" id="fc965">
        <field name="COMMENT">De stand van de HIVE (welke CELL omhoog staat) is bekend: bij de start RED AUDIENCE, daarna de laatste controle vlak voor het schieten. Geen tussenstop in het midden: direct naar de schietplek van die CELL en daar controleren (positie + CELL) voor het schieten.</field>
        <next>
          <block type="procedures_callnoreturn" id="fc983">
                                            <mutation name="setTargetCell"/>
                                            <next>
                                              <block type="procedures_callnoreturn" id="fc984">
                                                <mutation name="goToShootingSpot"/>
                                                <next>
                                                  <block type="comment" id="fc985">
                                                    <field name="COMMENT">Controle vlak voor de CELL: klopt de keuze niet, dan naar de andere CELL.</field>
                                                    <next>
                                                      <block type="variables_set" id="fc987">
                                                        <field name="VAR" id="v_upCellBefore">upCellBefore</field>
                                                        <value name="VALUE">
                                                          <block type="variables_get" id="fc986">
                                                            <field name="VAR" id="v_upCell">upCell</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="procedures_callnoreturn" id="fc988">
                                                            <mutation name="decideUpCell"/>
                                                            <next>
                                                              <block type="controls_if" id="fc1002">
                                                                <value name="IF0">
                                                                  <block type="logic_operation" id="fc993">
                                                                    <field name="OP">AND</field>
                                                                    <value name="A">
                                                                      <block type="variables_get" id="fc989">
                                                                        <field name="VAR" id="v_cellSure">cellSure</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="logic_compare" id="fc992">
                                                                        <field name="OP">NEQ</field>
                                                                        <value name="A">
                                                                          <block type="variables_get" id="fc990">
                                                                            <field name="VAR" id="v_upCell">upCell</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="B">
                                                                          <block type="variables_get" id="fc991">
                                                                            <field name="VAR" id="v_upCellBefore">upCellBefore</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <statement name="DO0">
                                                                  <block type="telemetry_addTextData_All" id="fc996">
                                                                    <value name="KEY">
                                                                      <block type="text" id="fc995">
                                                                        <field name="TEXT">Fase</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="TEXT">
                                                                      <block type="text" id="fc994">
                                                                        <field name="TEXT">Andere CELL staat omhoog: wisselen</field>
                                                                      </block>
                                                                    </value>
                                                                    <next>
                                                                      <block type="procedures_callnoreturn" id="rc33"><mutation name="showTime"></mutation><next><block type="telemetry_update" id="fc997">
                                                                        <next>
                                                                          <block type="procedures_callnoreturn" id="fc998">
                                                                            <mutation name="setTargetCell"/>
                                                                            <next>
                                                                              <block type="procedures_callnoreturn" id="fc999">
                                                                                <mutation name="leaveHive"/>
                                                                                <next>
                                                                                  <block type="procedures_callnoreturn" id="fc1000">
                                                                                    <mutation name="goToShootingSpot"/>
                                                                                    <next>
                                                                                      <block type="procedures_callnoreturn" id="fc1001">
                                                                                        <mutation name="decideUpCell"/>
                                                                                      </block>
                                                                                    </next>
                                                                                  </block>
                                                                                </next>
