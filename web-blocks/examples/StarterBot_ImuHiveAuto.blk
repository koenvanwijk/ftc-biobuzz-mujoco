                                                                                <next>
                                                                                  <block type="procedures_callnoreturn" id="fc1011">
                                                                                    <mutation name="shootAll"/>
                                                                                    <next>
                                                                                      <block type="variables_set" id="fc1015">
                                                                                        <field name="VAR" id="v_totalShots">totalShots</field>
                                                                                        <value name="VALUE">
                                                                                          <block type="math_arithmetic" id="fc1014">
                                                                                            <field name="OP">ADD</field>
                                                                                            <value name="A">
                                                                                              <block type="variables_get" id="fc1012">
                                                                                                <field name="VAR" id="v_totalShots">totalShots</field>
                                                                                              </block>
                                                                                            </value>
                                                                                            <value name="B">
                                                                                              <block type="variables_get" id="fc1013">
                                                                                                <field name="VAR" id="v_shots">shots</field>
                                                                                              </block>
                                                                                            </value>
                                                                                          </block>
                                                                                        </value>
                                                                                      </block>
                                                                                    </next>
                                                                                  </block>
                                                                                </next>
                                                                              </block></next></block>
                                                                            </next>
                                                                          </block>
                                                                        </next>
                                                                      </block>
                                                                    </statement>
                                                                    <statement name="ELSE">
                                                                      <block type="telemetry_addTextData_All" id="fc1018">
                                                                        <value name="KEY">
                                                                          <block type="text" id="fc1017">
                                                                            <field name="TEXT">Fase</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="TEXT">
                                                                          <block type="text" id="fc1016">
                                                                            <field name="TEXT">Onzeker welke CELL omhoog staat: niet schieten</field>
                                                                          </block>
                                                                        </value>
                                                                        <next>
                                                                          <block type="procedures_callnoreturn" id="rc35"><mutation name="showTime"></mutation><next><block type="telemetry_update" id="fc1019"/></next></block>
                                                                        </next>
                                                                      </block>
                                                                    </statement>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
        </next>
      </block>
    </statement>
  </block>
<block type="procedures_defnoreturn" id="rc205" x="2400" y="9000"><mutation><arg name="rcHeading" varid="v_rcHeading"></arg><arg name="rcBackM" varid="v_rcBackM"></arg></mutation><field name="NAME">rearCollect</field><statement name="STACK"><block type="comment" id="rc40"><field name="COMMENT">Gele POLLEN zoeken met de ACHTERcamera. Ziet hij er een, dan rijdt hij achteruit (intake aan) en stuurt op beeld-X: X &gt; 320 = bal links achter. Bal 0,8 s uit beeld (opgepakt) of te ver: stoppen. Niets gezien: de vaste afstand van de bekende plek (fallbackM).</field><next><block type="variables_set" id="rc41"><field name="VAR" id="v_fallbackM">fallbackM</field><value name="VALUE"><block type="variables_get" id="rc42"><field name="VAR" id="v_rcBackM">rcBackM</field></block></value><next><block type="variables_set" id="rc44"><field name="VAR" id="v_yellowSeen">yellowSeen</field><value name="VALUE"><block type="logic_boolean" id="rc43"><field name="BOOL">FALSE</field></block></value><next><block type="comment" id="rs00"><field name="COMMENT">Zoeken: de achtercamera kijkt achter de robot, dus langzaam ACHTERUIT rijden (intake aan) tot er geel in beeld komt, max. ±1,8 s.</field><next><block type="dcMotor_setDualProperty_RunMode" id="rs01"><field name="PROP">Mode</field><field name="IDENTIFIER1">leftDriveAsDcMotor</field><field name="IDENTIFIER2">rightDriveAsDcMotor</field><data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data><value name="VALUE1"><shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">STOP_AND_RESET_ENCODER</field></shadow></value><value name="VALUE2"><shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">STOP_AND_RESET_ENCODER</field></shadow></value><next><block type="dcMotor_setDualProperty_RunMode" id="rs02"><field name="PROP">Mode</field><field name="IDENTIFIER1">leftDriveAsDcMotor</field><field name="IDENTIFIER2">rightDriveAsDcMotor</field><data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data><value name="VALUE1"><shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">RUN_USING_ENCODER</field></shadow></value><value name="VALUE2"><shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">RUN_USING_ENCODER</field></shadow></value><next><block type="telemetry_addTextData_All" id="rs10"><value name="KEY"><block type="text" id="rs11"><field name="TEXT">Fase</field></block></value><value name="TEXT"><block type="text" id="rs12"><field name="TEXT">Gele POLLEN zoeken: langzaam achteruit (achtercamera)</field></block></value><next><block type="procedures_callnoreturn" id="rs14"><mutation name="showTime"></mutation><next><block type="telemetry_update" id="rs13"><next><block type="dcMotor_setDualProperty_Number" id="rs03"><field name="PROP">Power</field><field name="IDENTIFIER1">leftDriveAsDcMotor</field><field name="IDENTIFIER2">rightDriveAsDcMotor</field><data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data><value name="VALUE1"><block type="math_number" id="rs03a"><field name="NUM">-0.2</field></block></value><value name="VALUE2"><block type="math_number" id="rs03b"><field name="NUM">-0.2</field></block></value><next><block type="variables_set" id="rc45"><field name="VAR" id="v_look">look</field><value name="VALUE"><block type="math_number" id="rc46"><field name="NUM">0</field></block></value><next><block type="controls_whileUntil" id="rc73"><field name="MODE">WHILE</field><value name="BOOL"><block type="logic_operation" id="rc54"><field name="OP">AND</field><value name="A"><block type="linearOpMode_opModeIsActive" id="rc47"/></value><value name="B"><block type="logic_operation" id="rc53"><field name="OP">AND</field><value name="A"><block type="logic_negate" id="rc48"><value name="BOOL"><block type="variables_get" id="rc49"><field name="VAR" id="v_yellowSeen">yellowSeen</field></block></value></block></value><value name="B"><block type="logic_compare" id="rc50"><field name="OP">LT</field><value name="A"><block type="variables_get" id="rc51"><field name="VAR" 