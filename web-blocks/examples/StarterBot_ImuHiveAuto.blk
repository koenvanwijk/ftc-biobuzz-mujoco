  <block type="procedures_defnoreturn" id="b4" x="700" y="20">
    <field name="NAME">readHeading</field>
    <comment pinned="false" h="120" w="520">Leest de IMU-yaw in graden (tegen de klok in = positief, 0 = richting bij START).</comment>
    <statement name="STACK">
      <block type="variables_set" id="b3">
        <field name="VAR" id="v_heading">heading</field>
        <value name="VALUE">
          <block type="yawPitchRollAngles_getPropertyWithAngleUnit_Number" id="b1">
            <field name="PROP">Yaw</field>
            <value name="YAW_PITCH_ROLL_ANGLES">
              <block type="imu_getProperty_YawPitchRollAngles" id="b2">
                <field name="IDENTIFIER">imuAsIMU</field>
                <field name="PROP">RobotYawPitchRollAngles</field>
              </block>
            </value>
            <value name="ANGLE_UNIT">
              <shadow type="navigation_typedEnum_angleUnit">
                <field name="ANGLE_UNIT">DEGREES</field>
              </shadow>
            </value>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" id="b26" x="700" y="200">
    <mutation>
      <arg name="targetHeading" varid="v_targetHeading"/>
    </mutation>
    <field name="NAME">computeError</field>
    <comment pinned="false" h="120" w="520">error = targetHeading - heading, genormaliseerd naar (-180, 180].</comment>
    <statement name="STACK">
      <block type="procedures_callnoreturn" id="b5">
        <mutation name="readHeading"/>
        <next>
          <block type="variables_set" id="b9">
            <field name="VAR" id="v_error">error</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="b8">
                <field name="OP">MINUS</field>
                <value name="A">
                  <block type="variables_get" id="b6">
                    <field name="VAR" id="v_targetHeading">targetHeading</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="b7">
                    <field name="VAR" id="v_heading">heading</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_whileUntil" id="b17">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="logic_compare" id="b12">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="variables_get" id="b10">
                        <field name="VAR" id="v_error">error</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="b11">
                        <field name="NUM">180</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set" id="b16">
                    <field name="VAR" id="v_error">error</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="b15">
                        <field name="OP">MINUS</field>
                        <value name="A">
                          <block type="variables_get" id="b13">
                            <field name="VAR" id="v_error">error</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="b14">
                            <field name="NUM">360</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_whileUntil" id="b25">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="logic_compare" id="b20">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="b18">
                            <field name="VAR" id="v_error">error</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="b19">
                            <field name="NUM">-180</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set" id="b24">
                        <field name="VAR" id="v_error">error</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="b23">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="variables_get" id="b21">
                                <field name="VAR" id="v_error">error</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="b22">
                                <field name="NUM">360</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" id="b85" x="700" y="400">
    <mutation>
      <arg name="targetHeading" varid="v_targetHeading"/>
    </mutation>
    <field name="NAME">turnToHeading</field>
    <comment pinned="false" h="120" w="520">Draai op de plek naar targetHeading (graden) met P-regeling op de IMU-yaw; timeout 4 s.</comment>
    <statement name="STACK">
      <block type="variables_set" id="b28">
        <field name="VAR" id="v_startTime">startTime</field>
        <value name="VALUE">
          <block type="linearOpMode_getRuntime_Number" id="b27"/>
        </value>
        <next>
          <block type="procedures_callnoreturn" id="b30">
            <mutation name="computeError">
              <arg name="targetHeading"/>
            </mutation>
            <value name="ARG0">
              <block type="variables_get" id="b29">
                <field name="VAR" id="v_targetHeading">targetHeading</field>
              </block>
            </value>
            <next>
              <block type="controls_whileUntil" id="b79">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="logic_operation" id="b42">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="linearOpMode_opModeIsActive" id="b31"/>
                    </value>
                    <value name="B">
                      <block type="logic_operation" id="b41">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="b35">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="math_single" id="b33">
                                <field name="OP">ABS</field>
                                <value name="NUM">
                                  <block type="variables_get" id="b32">
                                    <field name="VAR" id="v_error">error</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="b34">
                                <field name="NUM">1.5</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="b40">
                            <field name="OP">LT</field>
                            <value name="A">
                              <block type="math_arithmetic" id="b38">
                                <field name="OP">MINUS</field>
                                <value name="A">
                                  <block type="linearOpMode_getRuntime_Number" id="b36"/>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="b37">
                                    <field name="VAR" id="v_startTime">startTime</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="b39">
                                <field name="NUM">4</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set" id="b49">
                    <field name="VAR" id="v_turnPower">turnPower</field>
                    <value name="VALUE">
                      <block type="math_constrain" id="b48">
                        <value name="VALUE">
                          <block type="math_arithmetic" id="b45">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="b43">
                                <field name="VAR" id="v_error">error</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="b44">
                                <field name="NUM">0.02</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="LOW">
                          <block type="math_number" id="b46">
                            <field name="NUM">-0.5</field>
                          </block>
                        </value>
                        <value name="HIGH">
                          <block type="math_number" id="b47">
                            <field name="NUM">0.5</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="controls_if" id="b62">
                        <value name="IF0">
                          <block type="logic_compare" id="b53">
                            <field name="OP">LT</field>
                            <value name="A">
                              <block type="math_single" id="b51">
                                <field name="OP">ABS</field>
                                <value name="NUM">
                                  <block type="variables_get" id="b50">
                                    <field name="VAR" id="v_turnPower">turnPower</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="b52">
                                <field name="NUM">0.1</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="controls_if" id="b61">
                            <mutation else="1"/>
                            <value name="IF0">
                              <block type="logic_compare" id="b56">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_get" id="b54">
                                    <field name="VAR" id="v_error">error</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="b55">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="b58">
                                <field name="VAR" id="v_turnPower">turnPower</field>
                                <value name="VALUE">
