  <block type="procedures_defnoreturn" id="b480" x="1300" y="1300">
    <field name="NAME">shootAll</field>
    <comment pinned="false" h="120" w="520">Schiet alle meegenomen elementen (max 4, G407): flywheel aan (300 ms), uit, 700 ms wachten; 4 keer.</comment>
    <statement name="STACK">
