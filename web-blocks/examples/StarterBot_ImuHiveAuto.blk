  <block type="procedures_defnoreturn" id="y5040" x="2500" y="20">
    <mutation>
      <arg name="ax" varid="v_ax"/>
      <arg name="ay" varid="v_ay"/>
    </mutation>
    <field name="NAME">angleTo</field>
    <comment pinned="false" h="120" w="520">angle = richting (graden) van de vector (ax, ay), zoals atan2.</comment>
    <statement name="STACK">
      <block type="controls_if" id="y5039">
        <mutation else="1"/>
        <value name="IF0">
          <block type="logic_compare" id="y5003">
            <field name="OP">GT</field>
            <value name="A">
              <block type="variables_get" id="y5001">
                <field name="VAR" id="v_ax">ax</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="y5002">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="y5008">
            <field name="VAR" id="v_angle">angle</field>
            <value name="VALUE">
              <block type="math_trig" id="y5007">
                <field name="OP">ATAN</field>
                <value name="NUM">
                  <block type="math_arithmetic" id="y5006">
                    <field name="OP">DIVIDE</field>
                    <value name="A">
                      <block type="variables_get" id="y5004">
                        <field name="VAR" id="v_ay">ay</field>
                      </block>
