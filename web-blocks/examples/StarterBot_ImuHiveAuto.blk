  <block type="procedures_defnoreturn" id="y5472" x="3300" y="20">
    <field name="NAME">decideUpCell</field>
    <comment pinned="false" h="120" w="520">Bepaal welke rode CELL omhoog staat (upCell), met meerdere beelden en beide clusters. cellSure = true als de meting duidelijk was.</comment>
    <statement name="STACK">
      <block type="comment" id="y5310">
        <field name="COMMENT">Meet over 6 beelden de hoogste hoogte (tagZ) van beide rode clusters. Zie je ze allebei: de hoogste staat omhoog (relatief, dus ongevoelig voor kanteling/afstand). Zie je er maar een: alleen beslissen als de hoogte duidelijk is (&gt; 1,30 m omhoog of &lt; 1,10 m omlaag). Anders: upCell niet veranderen en cellSure = false.</field>
        <next>
          <block type="variables_set" id="y5312">
            <field name="VAR" id="v_zAud">zAud</field>
            <value name="VALUE">
              <block type="math_number" id="y5311">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="y5314">
                <field name="VAR" id="v_zSco">zSco</field>
                <value name="VALUE">
                  <block type="math_number" id="y5313">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="y5316">
                    <field name="VAR" id="v_nAud">nAud</field>
                    <value name="VALUE">
                      <block type="math_number" id="y5315">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="y5318">
                        <field name="VAR" id="v_nSco">nSco</field>
                        <value name="VALUE">
                          <block type="math_number" id="y5317">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="y5320">
                            <field name="VAR" id="v_frame">frame</field>
                            <value name="VALUE">
                              <block type="math_number" id="y5319">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="controls_whileUntil" id="y5389">
                                <field name="MODE">WHILE</field>
                                <value name="BOOL">
                                  <block type="logic_operation" id="y5325">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="linearOpMode_opModeIsActive" id="y5321"/>
                                    </value>
                                    <value name="B">
                                      <block type="logic_compare" id="y5324">
                                        <field name="OP">LT</field>
                                        <value name="A">
                                          <block type="variables_get" id="y5322">
                                            <field name="VAR" id="v_frame">frame</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number" id="y5323">
                                            <field name="NUM">6</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="linearOpMode_sleep" id="y5327">
                                    <value name="MILLISECONDS">
                                      <block type="math_number" id="y5326">
                                        <field name="NUM">150</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="y5330">
                                        <field name="VAR" id="v_detections">detections</field>
                                        <value name="VALUE">
