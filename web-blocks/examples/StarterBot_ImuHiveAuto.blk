                                                                <mutation name="turnToHeading">
                                                                  <arg name="targetHeading"/>
                                                                </mutation>
                                                                <value name="ARG0">
                                                                  <block type="math_arithmetic" id="fc948">
                                                                    <field name="OP">MINUS</field>
                                                                    <value name="A">
                                                                      <block type="variables_get" id="fc946">
                                                                        <field name="VAR" id="v_pHeading">pHeading</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="math_number" id="fc947">
                                                                        <field name="NUM">20</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="procedures_callnoreturn" id="fc951">
                                                                    <mutation name="turnToHeading">
                                                                      <arg name="targetHeading"/>
                                                                    </mutation>
                                                                    <value name="ARG0">
                                                                      <block type="variables_get" id="fc950">
                                                                        <field name="VAR" id="v_pHeading">pHeading</field>
                                                                      </block>
                                                                    </value>
                                                                    <next>
