  <block type="procedures_defnoreturn" id="y5070" x="2500" y="300">
    <mutation>
      <arg name="meters" varid="v_meters"/>
      <arg name="targetHeading" varid="v_targetHeading"/>
      <arg name="maxPower" varid="v_maxPower"/>
    </mutation>
    <field name="NAME">driveOdo</field>
    <comment pinned="false" h="120" w="520">driveStraight + odometrie: werk robotX/robotY bij met de gereden encoderafstand en de koers.</comment>
    <statement name="STACK">
      <block type="procedures_callnoreturn" id="y5044">
        <mutation name="driveStraight">
          <arg name="meters"/>
          <arg name="targetHeading"/>
          <arg name="maxPower"/>
        </mutation>
        <value name="ARG0">
          <block type="variables_get" id="y5041">
            <field name="VAR" id="v_meters">meters</field>
          </block>
        </value>
        <value name="ARG1">
          <block type="variables_get" id="y5042">
            <field name="VAR" id="v_targetHeading">targetHeading</field>
          </block>
        </value>
        <value name="ARG2">
          <block type="variables_get" id="y5043">
            <field name="VAR" id="v_maxPower">maxPower</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="y5048">
            <field name="VAR" id="v_odoDist">odoDist</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="y5047">
                <field name="OP">DIVIDE</field>
                <value name="A">
                  <block type="variables_get" id="y5045">
                    <field name="VAR" id="v_ticksDriven">ticksDriven</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="y5046">
                    <field name="VAR" id="v_TICKS_PER_METER">TICKS_PER_METER</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="y5055">
                <value name="IF0">
                  <block type="logic_compare" id="y5051">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="variables_get" id="y5049">
                        <field name="VAR" id="v_maxPower">maxPower</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="y5050">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="y5054">
                    <field name="VAR" id="v_odoDist">odoDist</field>
                    <value name="VALUE">
                      <block type="math_single" id="y5053">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get" id="y5052">
                            <field name="VAR" id="v_odoDist">odoDist</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="variables_set" id="y5062">
                    <field name="VAR" id="v_robotX">robotX</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="y5061">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get" id="y5056">
                            <field name="VAR" id="v_robotX">robotX</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_arithmetic" id="y5060">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="y5057">
                                <field name="VAR" id="v_odoDist">odoDist</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_trig" id="y5059">
                                <field name="OP">COS</field>
                                <value name="NUM">
                                  <block type="variables_get" id="y5058">
                                    <field name="VAR" id="v_targetHeading">targetHeading</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="y5069">
                        <field name="VAR" id="v_robotY">robotY</field>
                        <value name="VALUE">
