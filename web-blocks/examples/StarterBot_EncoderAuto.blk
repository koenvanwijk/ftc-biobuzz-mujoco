<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="procedures_defnoreturn" id="run3" deletable="false" x="20" y="20">
    <field name="NAME">runOpMode</field>
    <comment pinned="false" h="80" w="420">Encoder auto: wheel-joint encoders (BIOBUZZ left_wheel_j/right_wheel_j) + RUN_TO_POSITION.</comment>
    <statement name="STACK">
      <block type="dcMotor_setDualProperty_RunMode" id="reset">
        <field name="PROP">Mode</field>
        <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
        <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
        <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
        <value name="VALUE1">
          <shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">STOP_AND_RESET_ENCODER</field></shadow>
        </value>
        <value name="VALUE2">
          <shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">STOP_AND_RESET_ENCODER</field></shadow>
        </value>
        <next>
          <block type="dcMotor_setDualProperty_Number" id="tgt">
            <field name="PROP">TargetPosition</field>
            <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
            <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
            <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
            <value name="VALUE1"><block type="math_number"><field name="NUM">1000</field></block></value>
            <value name="VALUE2"><block type="math_number"><field name="NUM">1000</field></block></value>
            <next>
              <block type="dcMotor_setDualProperty_RunMode" id="rtp">
                <field name="PROP">Mode</field>
                <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                <value name="VALUE1">
                  <shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">RUN_TO_POSITION</field></shadow>
                </value>
                <value name="VALUE2">
                  <shadow type="dcMotor_typedEnum_runMode"><field name="RUN_MODE">RUN_TO_POSITION</field></shadow>
                </value>
                <next>
                  <block type="dcMotor_setDualProperty_Number" id="pow">
                    <field name="PROP">Power</field>
                    <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                    <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                    <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                    <value name="VALUE1"><block type="math_number"><field name="NUM">0.4</field></block></value>
                    <value name="VALUE2"><block type="math_number"><field name="NUM">0.4</field></block></value>
                    <next>
                      <block type="linearOpMode_waitForStart" id="wfs3">
                        <next>
                          <block type="controls_whileUntil" id="waitBusy">
                            <field name="MODE">WHILE</field>
                            <value name="BOOL">
                              <block type="logic_operation" id="and1">
                                <field name="OP">AND</field>
                                <value name="A"><block type="linearOpMode_opModeIsActive" id="a3"/></value>
                                <value name="B">
                                  <block type="logic_operation" id="orBusy">
                                    <field name="OP">OR</field>
                                    <value name="A">
                                      <block type="dcMotor_isBusy" id="bL">
                                        <field name="IDENTIFIER">leftDriveAsDcMotor</field>
                                        <data>{"IDENTIFIER":"leftDrive"}</data>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="dcMotor_isBusy" id="bR">
                                        <field name="IDENTIFIER">rightDriveAsDcMotor</field>
                                        <data>{"IDENTIFIER":"rightDrive"}</data>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="linearOpMode_idle" id="idle1">
                                <next>
                                  <block type="telemetry_addNumericData_Number" id="te">
                                    <value name="KEY"><block type="text"><field name="TEXT">L</field></block></value>
                                    <value name="NUMBER">
                                      <block type="dcMotor_getProperty_Number" id="ge">
                                        <field name="IDENTIFIER">leftDriveAsDcMotor</field>
                                        <field name="PROP">CurrentPosition</field>
                                        <data>{"IDENTIFIER":"leftDrive"}</data>
                                      </block>
                                    </value>
                                    <next><block type="telemetry_update" id="tu3"/></next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="dcMotor_setDualProperty_Number" id="stopM">
                                <field name="PROP">Power</field>
                                <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                                <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                                <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                                <value name="VALUE1"><block type="math_number"><field name="NUM">0</field></block></value>
                                <value name="VALUE2"><block type="math_number"><field name="NUM">0</field></block></value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml><?xml version='1.0' encoding='UTF-8' standalone='yes' ?><Extra><OpModeMeta flavor="AUTONOMOUS" group="Sim" autoTransition="" /><Enabled value="true" /></Extra> 