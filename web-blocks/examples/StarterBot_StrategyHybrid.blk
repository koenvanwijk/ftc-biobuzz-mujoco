>cellUp</field><comment pinned="false" h="140" w="560">Is the CELL of CLUSTER_NAME up? Measures the height of its AprilTag cluster (max 0.6 s): an up CELL has its tags above 1.2 m. Returns 1 (up), 0 (down) or -1 (not seen).</comment><statement name="STACK"><block type="variables_set"><field name="VAR" id="v_tStart">tStart</field><value name="VALUE"><block type="linearOpMode_getRuntime_Number"/></value><next><block type="variables_set"><field name="VAR" id="v_res">res</field><value name="VALUE"><block type="math_number"><field name="NUM">-1</field></block></value><next><block type="controls_whileUntil"><field name="MODE">WHILE</field><value name="BOOL"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="linearOpMode_opModeIsActive"/></value><value name="B"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_res">res</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="linearOpMode_getRuntime_Number"/></value><value name="B"><block type="variables_get"><field name="VAR" id="v_tStart">tStart</field></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">0.6</field></block></value></block></value></block></value><statement name="DO"><block type="controls_forEach"><field name="VAR" id="v_detection">detection</field><value name="LIST"><block type="aprilTagProcessor_getDetections"><value name="APRIL_TAG_PROCESSOR"><block type="variables_get"><field name="VAR" id="v_myAprilTagProcessor">myAprilTagProcessor</field></block></value></block></value><statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="aprilTagDetection2_getProperty_Boolean"><field name="PROP">isClusterDetection</field><value name="APRIL_TAG_DETECTION"><block type="variables_get"><field name="VAR" id="v_detection">detection</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="aprilTagClusterDetection_getProperty_String"><field name="PROP">metadata.name</field><value name="APRIL_TAG_CLUSTER_DETECTION"><block type="variables_get"><field name="VAR" id="v_detection">detection</field></block></value></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_CLUSTER_NAME">CLUSTER_NAME</field></block></value></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="v_fwd">fwd</field><value name="VALUE"><block type="aprilTagDetection2_getProperty_Number"><field name="PROP">ftcPose.y</field><value name="APRIL_TAG_DETECTION"><block type="variables_get"><field name="VAR" id="v_detection">detection</field></block></value></block></value><next><block type="variables_set"><field name="VAR" id="v_up">up</field><value name="VALUE"><block type="aprilTagDetection2_getProperty_Number"><field name="PROP">ftcPose.z</field><value name="APRIL_TAG_DETECTION"><block type="variables_get"><field name="VAR" id="v_detection">detection</field></block></value></block></value><next><block type="variables_set"><field name="VAR" id="v_tagZ">tagZ</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="v_CAMERA_HEIGHT_M">CAMERA_HEIGHT_M</field></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="v_fwd">fwd</field></block></value><value name="B"><block type="math_trig"><field name="OP">SIN</field><value name="NUM"><block type="variables_get"><field name="VAR" id="v_CAMERA_PITCH_DEG">CAMERA_PITCH_DEG</field></block></value></block></value></block></value></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="v_up">up</field></block></value><value name="B"><block type="math_trig"><field name="OP">COS</field><value name="NUM"><block type="variables_get"><field name="VAR" id="v_CAMERA_PITCH_DEG">CAMERA_PITCH_DEG</field></block></value></block></value></block></value></block></value><next><block type="controls_if"><mutation else="1"/><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_tagZ">tagZ</field></block></value><value name="B"><block type="math_number"><field name="NUM">1.2</field></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="v_res">res</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement><statement name="ELSE"><block type="variables_set"><field name="VAR" id="v_res">res</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement></block></next></block></next></block></next></block></statement></block></statement><next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_res">res</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="linearOpMode_sleep"><value name="MILLISECONDS"><block type="math_number"><field name="NUM">50</field></block></value></block></statement></block></next></block></statement></block></next></block></next></block></statement><value name="RETURN"><block type="variables_get"><field name="VAR" id="v_res">res</field></block></value></block><block type="procedures_defnoreturn" x="1120" y="5072"><mutation><arg name="n" varid="v_n"/></mutation><field name="NAME">scoreInHive</field><comment pinned="false" h="140" w="560">Score n POLLEN in the HIVE: drive to the shooting spot of the up CELL, check with the tags that it really is up (else switch to the other red CELL), aim and shoot. The caller keeps track of TIPs (upCell) by counting: 3 NECTAR + 3 POLLEN, or 8 POLLEN.</comment><statement name="STACK"><block type="procedures_callnoreturn"><mutation name="goToShootingSpot"><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">0.9</field></block></value><next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="procedures_callreturn"><mutation name="cellUp"></mutation></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="v_upCell">upCell</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="math_number"><field name="NUM">1</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_upCell">upCell</field></block></value></block></value><next><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Other CELL is up: switching</field></block></value><next><block type="procedures_callnoreturn"><mutation name="goToShootingSpot"><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">0.9</field></block></value></block></next></block></next></block></statement><next><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Shooting into the HIVE</field></block></value><next><block type="variables_set"><field name="VAR" id="v_aimHeading">aimHeading</field><value name="VALUE"><block type="procedures_callreturn"><mutation name="readHeading"></mutation></block></value><next><block type="procedures_callnoreturn"><mutation name="shootSpread"><arg name="n"/></mutation><value name="ARG0"><block type="variables_get"><field name="VAR" id="v_n">n</field></block></value><next><block type="linearOpMode_sleep"><value name="MILLISECONDS"><block type="math_number"><field name="NUM">1000</field></block></value></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" x="2220" y="5378"><field name="NAME">park</field><comment pinned="false" h="140" w="560">Drive to the red LOADING ZONE (A5, against the red wall) and stop there: PARK.</comment><statement name="STACK"><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Parking in the LOADING ZONE</field></block></value><next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_robotX">robotX</field></block></value><value name="B"><block type="math_number"><field name="NUM">-0.9</field></block></value></block></value><statement name="DO0"><block type="controls_if"><mutation else="1"/><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_robotY">robotY</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="procedures_callnoreturn"><mutation name="goTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-1.1</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">1.15</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">1</field></block></value></block></statement><statement name="ELSE"><block type="procedures_callnoreturn"><mutation name="goTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-1.1</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">-1.1</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">1</field></block></value></block></statement></block></statement><next><block type="procedures_callnoreturn"><mutation name="goTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-1.1</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">0.914</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="procedures_callnoreturn"><mutation name="backTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-1.5</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">0.914</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">0.8</field></block></value></block></next></block></next></block></next></block></statement></block></xml><?xml version='1.0' encoding='UTF-8' standalone='yes' ?><Extra><OpModeMeta flavor="AUTONOMOUS" group="Sim" autoTransition="" /><Enabled value="true" /></Extra>