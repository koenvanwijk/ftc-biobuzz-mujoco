<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="v_CAMERA_FORWARD_M">CAMERA_FORWARD_M</variable><variable id="v_CAMERA_HEIGHT_M">CAMERA_HEIGHT_M</variable><variable id="v_CAMERA_PITCH_DEG">CAMERA_PITCH_DEG</variable><variable id="v_CLUSTER_NAME">CLUSTER_NAME</variable><variable id="v_PARK_RESERVE_S">PARK_RESERVE_S</variable><variable id="v_SHOOT_DISTANCE_M">SHOOT_DISTANCE_M</variable><variable id="v_SHOOT_HEADING">SHOOT_HEADING</variable><variable id="v_TAG_X">TAG_X</variable><variable id="v_TAG_Y">TAG_Y</variable><variable id="v_TICKS_PER_METER">TICKS_PER_METER</variable><variable id="v_TOTAL_TIME_S">TOTAL_TIME_S</variable><variable id="v_aimHeading">aimHeading</variable><variable id="v_aimed">aimed</variable><variable id="v_aligned">aligned</variable><variable id="v_along">along</variable><variable id="v_ang">ang</variable><variable id="v_ax">ax</variable><variable id="v_ay">ay</variable><variable id="v_backMeters">backMeters</variable><variable id="v_bearing">bearing</variable><variable id="v_cHeading">cHeading</variable><variable id="v_cellShots">cellShots</variable><variable id="v_corr">corr</variable><variable id="v_detection">detection</variable><variable id="v_dist">dist</variable><variable id="v_driven">driven</variable><variable id="v_dx">dx</variable><variable id="v_dy">dy</variable><variable id="v_err">err</variable><variable id="v_found">found</variable><variable id="v_fwd">fwd</variable><variable id="v_fwdH">fwdH</variable><variable id="v_gdist">gdist</variable><variable id="v_gdx">gdx</variable><variable id="v_gdy">gdy</variable><variable id="v_goHeading">goHeading</variable><variable id="v_gx">gx</variable><variable id="v_gy">gy</variable><variable id="v_heading">heading</variable><variable id="v_k">k</variable><variable id="v_lateral">lateral</variable><variable id="v_meters">meters</variable><variable id="v_myAprilTagProcessor">myAprilTagProcessor</variable><variable id="v_myVisionPortal">myVisionPortal</variable><variable id="v_myVisionPortalBuilder" type="VisionPortal.Builder">myVisionPortalBuilder</variable><variable id="v_n">n</variable><variable id="v_phase">phase</variable><variable id="v_power">power</variable><variable id="v_pw">pw</variable><variable id="v_remaining">remaining</variable><variable id="v_res">res</variable><variable id="v_robotX">robotX</variable><variable id="v_robotY">robotY</variable><variable id="v_seen">seen</variable><variable id="v_shotsFired">shotsFired</variable><variable id="v_side">side</variable><variable id="v_spotX">spotX</variable><variable id="v_spotY">spotY</variable><variable id="v_spread">spread</variable><variable id="v_startT">startT</variable><variable id="v_tStart">tStart</variable><variable id="v_tagZ">tagZ</variable><variable id="v_targetHeading">targetHeading</variable><variable id="v_ticksTarget">ticksTarget</variable><variable id="v_tips">tips</variable><variable id="v_tries">tries</variable><variable id="v_turnPower">turnPower</variable><variable id="v_up">up</variable><variable id="v_upCell">upCell</variable></variables><block type="procedures_defnoreturn" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="140" w="560">BIOBUZZ strategy 3 - HYBRID / SAFE (red, start A6): HIVE for the points, the back-wall FLOWER as POLLEN supply, GARDEN left alone and an early PARK. Without NECTAR the FLOWERS score nothing for us, so their POLLEN are free to take, while the 4 POLLEN in the GARDEN corner already score 1 point each where they lie. 1) 3 preload POLLEN TIP the RED AUDIENCE CELL (3 NECTAR + 3 POLLEN, +20). 2) Floor cluster into RED SCORING. 3) Back-wall FLOWER (right behind the RED SCORING spot): 8 POLLEN = TIP 2. 4) PARK in the red LOADING ZONE straight away: only the two short, reliable trips, with a large time reserve.</comment><statement name="STACK"><block type="variables_set"><field name="VAR" id="v_TICKS_PER_METER">TICKS_PER_METER</field><value name="VALUE"><block type="math_number"><field name="NUM">1981</field></block></value><next><block type="variables_set"><field name="VAR" id="v_CAMERA_PITCH_DEG">CAMERA_PITCH_DEG</field><value name="VALUE"><block type="math_number"><field name="NUM">45</field></block></value><next><block type="variables_set"><field name="VAR" id="v_CAMERA_FORWARD_M">CAMERA_FORWARD_M</field><value name="VALUE"><block type="math_number"><field name="NUM">0.24</field></block></value><next><block type="variables_set"><field name="VAR" id="v_CAMERA_HEIGHT_M">CAMERA_HEIGHT_M</field><value name="VALUE"><block type="math_number"><field name="NUM">0.08</field></block></value><next><block type="variables_set"><field name="VAR" id="v_SHOOT_DISTANCE_M">SHOOT_DISTANCE_M</field><value name="VALUE"><block type="math_number"><field name="NUM">1.1</field></block></value><next><block type="variables_set"><field name="VAR" id="v_TOTAL_TIME_S">TOTAL_TIME_S</field><value name="VALUE"><block type="math_number"><field name="NUM">120</field></block></value><next><block type="variables_set"><field name="VAR" id="v_PARK_RESERVE_S">PARK_RESERVE_S</field><value name="VALUE"><block type="math_number"><field name="NUM">15</field></block></value><next><block type="variables_set"><field name="VAR" id="v_robotX">robotX</field><value name="VALUE"><block type="math_number"><field name="NUM">-1.569</field></block></value><next><block type="variables_set"><field name="VAR" id="v_robotY">robotY</field><value name="VALUE"><block type="math_number"><field name="NUM">1.476</field></block></value><next><block type="variables_set"><field name="VAR" id="v_upCell">upCell</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set"><field name="VAR" id="v_shotsFired">shotsFired</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set"><field name="VAR" id="v_cellShots">cellShots</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set"><field name="VAR" id="v_tips">tips</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="dcMotor_setProperty_Direction"><field name="IDENTIFIER">leftDriveAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"leftDrive"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction"><field name="DIRECTION">FORWARD</field></shadow></value><next><block type="dcMotor_setProperty_Direction"><field name="IDENTIFIER">rightDriveAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"rightDrive"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction"><field name="DIRECTION">REVERSE</field></shadow></value><next><block type="dcMotor_setDualProperty_ZeroPowerBehavior"><field name="PROP">ZeroPowerBehavior</field><field name="IDENTIFIER1">leftDriveAsDcMotor</field><field name="IDENTIFIER2">rightDriveAsDcMotor</field><data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data><value name="VALUE1"><shadow type="dcMotor_typedEnum_zeroPowerBehavior"><field name="ZERO_POWER_BEHAVIOR">BRAKE</field></shadow></value><value name="VALUE2"><shadow type="dcMotor_typedEnum_zeroPowerBehavior"><field name="ZERO_POWER_BEHAVIOR">BRAKE</field></shadow></value><next><block type="imu_initialize"><field name="IDENTIFIER">imuAsIMU</field><value name="PARAMETERS"><block type="imuParameters_create"><value name="IMU_ORIENTATION_ON_ROBOT"><block type="revHubOrientationOnRobot_create1"><value name="LOGO_FACING_DIRECTION"><block type="revHubOrientationOnRobot_typedEnum_logoFacingDirection"><field name="LOGO_FACING_DIRECTION">UP</field></block></value><value name="USB_FACING_DIRECTION"><block type="revHubOrientationOnRobot_typedEnum_usbFacingDirection"><field name="USB_FACING_DIRECTION">RIGHT</field></block></value></block></value></block></value><next><block type="variables_set"><field name="VAR" id="v_myAprilTagProcessor">myAprilTagProcessor</field><value name="VALUE"><block type="aprilTagProcessor_easyCreateWithDefaults"/></value><next><block type="visionPortalBuilder_create_assign"><field name="VISION_PORTAL_BUILDER" id="v_myVisionPortalBuilder" variabletype="VisionPortal.Builder">myVisionPortalBuilder</field><next><block type="visionPortalBuilder_setCamera"><field name="VISION_PORTAL_BUILDER" id="v_myVisionPortalBuilder" variabletype="VisionPortal.Builder">myVisionPortalBuilder</field><value name="CAMERA"><block type="navigation_switchableCamera_forAllWebcams"/></value><next><block type="visionPortalBuilder_addProcessor"><field name="VISION_PORTAL_BUILDER" id="v_myVisionPortalBuilder" variabletype="VisionPortal.Builder">myVisionPortalBuilder</field><value name="VISION_PROCESSOR"><block type="variables_get"><field name="VAR" id="v_myAprilTagProcessor">myAprilTagProcessor</field></block></value><next><block type="variables_set"><field name="VAR" id="v_myVisionPortal">myVisionPortal</field><value name="VALUE"><block type="visionPortalBuilder_build"><field name="VISION_PORTAL_BUILDER" id="v_myVisionPortalBuilder" variabletype="VisionPortal.Builder">myVisionPortalBuilder</field></block></value><next><block type="visionPortal_setActiveCamera"><value name="VISION_PORTAL"><block type="variables_get"><field name="VAR" id="v_myVisionPortal">myVisionPortal</field></block></value><value name="WEBCAM_NAME"><shadow type="navigation_webcamName"><field name="WEBCAM_NAME">Webcam 1</field></shadow></value><next><block type="telemetry_addTextData_All"><value name="KEY"><block type="text"><field name="TEXT">Status</field></block></value><value name="TEXT"><block type="text"><field name="TEXT">HYBRID strategy ready. Press START.</field></block></value><next><block type="telemetry_update"><next><block type="linearOpMode_waitForStart"><next><block type="variables_set"><field name="VAR" id="v_startT">startT</field><value name="VALUE"><block type="linearOpMode_getRuntime_Number"/></value><next><block type="imu_resetYaw"><field name="IDENTIFIER">imuAsIMU</field><next><block type="comment"><field name="COMMENT">1) 3 preload POLLEN into RED AUDIENCE (holds the 3 red NECTAR): TIP 1. Keep the 4th.</field><next><block type="procedures_callnoreturn"><mutation name="scoreInHive"><arg name="n"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">3</field></block></value><next><block type="variables_set"><field name="VAR" id="v_upCell">upCell</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="variables_set"><field name="VAR" id="v_tips">tips</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="comment"><field name="COMMENT">2) Floor cluster: 3 fit next to the kept one (G407: max 4). Leave along the audience wall (TIP spill).</field><next><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Collecting: floor cluster</field></block></value><next><block type="procedures_callnoreturn"><mutation name="backTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-0.32</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">-1.58</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">0.5</field></block></value><next><block type="procedures_callnoreturn"><mutation name="goTo"><arg name="gx"/><arg name="gy"/><arg name="power"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-0.95</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">-1.58</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">0.7</field></block></value><next><block type="procedures_callnoreturn"><mutation name="collect"><arg name="ax"/><arg name="ay"/><arg name="cHeading"/><arg name="backMeters"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-1</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">-1.229</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">0</field></block></value><value name="ARG3"><block type="math_number"><field name="NUM">0.5</field></block></value><next><block type="procedures_callnoreturn"><mutation name="scoreInHive"><arg name="n"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">4</field></block></value><next><block type="comment"><field name="COMMENT">3) Back-wall FLOWER right behind the RED SCORING spot: its POLLEN score nothing there for us. 8 in the CELL = TIP 2.</field><next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="procedures_callreturn"><mutation name="elapsed"></mutation></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="variables_get"><field name="VAR" id="v_TOTAL_TIME_S">TOTAL_TIME_S</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_PARK_RESERVE_S">PARK_RESERVE_S</field></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">15</field></block></value></block></value></block></value><statement name="DO0"><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Collecting: back-wall FLOWER</field></block></value><next><block type="procedures_callnoreturn"><mutation name="collect"><arg name="ax"/><arg name="ay"/><arg name="cHeading"/><arg name="backMeters"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">-0.594</field></block></value><value name="ARG1"><block type="math_number"><field name="NUM">1.05</field></block></value><value name="ARG2"><block type="math_number"><field name="NUM">-90</field></block></value><value name="ARG3"><block type="math_number"><field name="NUM">0.38</field></block></value><next><block type="procedures_callnoreturn"><mutation name="scoreInHive"><arg name="n"/></mutation><value name="ARG0"><block type="math_number"><field name="NUM">4</field></block></value><next><block type="variables_set"><field name="VAR" id="v_upCell">upCell</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set"><field name="VAR" id="v_tips">tips</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></next></block></next></block></next></block></next></block></statement><next><block type="comment"><field name="COMMENT">4) PARK right away; the GARDEN POLLEN stay where they score (+1 each).</field><next><block type="procedures_callnoreturn"><mutation name="park"></mutation><next><block type="controls_whileUntil"><field name="MODE">WHILE</field><value name="BOOL"><block type="linearOpMode_opModeIsActive"/></value><statement name="DO"><block type="procedures_callnoreturn"><mutation name="show"><arg name="phase"/></mutation><value name="ARG0"><block type="text"><field name="TEXT">Done</field></block></value><next><block type="linearOpMode_sleep"><value name="MILLISECONDS"><block type="math_number"><field name="NUM">200</field></block></value></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="procedures_defreturn" x="1120" y="20"><field name="NAME">readHeading</field><comment pinned="false" h="140" w="560">IMU yaw in degrees (counter-clockwise = positive). 0 = the heading at START, which on the BIOBUZZ field is +X (the red start faces the HIVE).</comment><statement name="STACK"></statement><value name="RETURN"><block type="yawPitchRollAngles_getPropertyWithAngleUnit_Number"><field name="PROP">Yaw</field><value name="YAW_PITCH_ROLL_ANGLES"><block type="imu_getProperty_YawPitchRollAngles"><field name="IDENTIFIER">imuAsIMU</field><field name="PROP">RobotYawPitchRollAngles</field></block></value><value name="ANGLE_UNIT"><shadow type="navigation_typedEnum_angleUnit"><field name="ANGLE_UNIT">DEGREES</field></shadow></value></block></value></block><block type="procedures_defreturn" x="2220" y="20"><mutation><arg name="targetHeading" varid="v_targetHeading"/></mutation><field name="NAME">headingError</field><comment pinned="false" h="140" w="560">Heading error targetHeading - heading, normalised to (-180, 180].</comment><statement name="STACK"><block type="variables_set"><field name="VAR" id="v_err">err</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="variables_get"><field name="VAR" id="v_targetHeading">targetHeading</field></block></value><value name="B"><block type="procedures_callreturn"><mutation name="readHeading"></mutation></block></value></block></value><next><block type="controls_whileUntil"><field name="MODE">WHILE</field><value name="BOOL"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_err">err</field></block></value><value name="B"><block type="math_number"><field name="NUM">180</field></block></value></block></value><statement name="DO"><block type="variables_set"><field name="VAR" id="v_err">err</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="variables_get"><field name="VAR" id="v_err">err</field></block></value><value name="B"><block type="math_number"><field name="NUM">360</field></block></value></block></value></block></statement><next><block type="controls_whileUntil"><field name="MODE">WHILE</field><value name="BOOL"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_err">err</field></block></value><value name="B"><block type="math_number"><field name="NUM">-180</field></block></value></block></value><statement name="DO"><block type="variables_set"><field name="VAR" id="v_err">err</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="v_err">err</field></block></value><value name="B"><block type="math_number"><field name="NUM">360</field></block></value></block></value></block></statement></block></next></block></next></block></statement><value name="RETURN"><block type="variables_get"><field name="VAR" id="v_err">err</field></block></value></block><block type="procedures_defreturn" x="1120" y="320"><mutation><arg name="ax" varid="v_ax"/><arg name="ay" varid="v_ay"/></mutation><field name="NAME">angleTo</field><comment pinned="false" h="140" w="560">angle (degrees) of the vector (ax, ay), like atan2.</comment><statement name="STACK"><block type="controls_if"><mutation elseif="2" else="1"/><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ax">ax</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="v_ang">ang</field><value name="VALUE"><block type="math_trig"><field name="OP">ATAN</field><value name="NUM"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ay">ay</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_ax">ax</field></block></value></block></value></block></value></block></statement><value name="IF1"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ax">ax</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO1"><block type="controls_if"><mutation else="1"/><value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ay">ay</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="v_ang">ang</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="math_trig"><field name="OP">ATAN</field><value name="NUM"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ay">ay</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_ax">ax</field></block></value></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">180</field></block></value></block></value></block></statement><statement name="ELSE"><block type="variables_set"><field name="VAR" id="v_ang">ang</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="math_trig"><field name="OP">ATAN</field><value name="NUM"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ay">ay</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="v_ax">ax</field></block></value></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">180</field></block></value></block></value></block></statement></block></statement><value name="IF2"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_get"><field name="VAR" id="v_ay">ay</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value><statement name="DO2"><block type="variables_set"><field name="VAR" id="v_ang">ang</field><value name="VALUE"><block type="math_number"><field name="NUM">90</field></block></value></block></statement><statement name="ELSE"><block type="variables_set"><field name="VAR" id="v_ang">ang</field><value name="VALUE"><block type="math_number"><field name="NUM">-90</field></block></value></block></statement></block></statement><value name="RETURN"><block type="variables_get"><field name="VAR" id="v_ang">ang</field></block></value></block><block type="procedures_defnoreturn" x="2220" y="490"><mutation><arg name="targetHeading" varid="v_targetHeading"/></mutation><field name="NAME">turnTo</field><comment pinned="false" h="140" w="560">Turn in place to targetHeading (degrees) with a P controller on the IMU yaw. Max power 0.7, min 0.12, done within 1.5 degrees or after 2.5 s.</comment><statement name="STACK"><block type="variables_set"><field name="VAR" id="v_tStart">tStart</field><value name="VALUE"><block type="linearOpMode_getRuntime_Number"/></value><next><block type="variables_set"><field name="VAR" id="v_err">err</field><value name="VALUE"><block type="procedures_callreturn"><mutation name="headingError"><arg name="targetHeading"/></mutation><value name="ARG0"><block type="varia