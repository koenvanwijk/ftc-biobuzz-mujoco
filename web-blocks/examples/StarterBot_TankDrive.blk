<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="varL">leftPow</variable><variable id="varR">rightPow</variable></variables>
  <block type="procedures_defnoreturn" id="run1" deletable="false" x="20" y="20">
    <field name="NAME">runOpMode</field>
    <comment pinned="false" h="80" w="400">Tank drive — BIOBUZZ left_drive/right_drive via setTankPower; werkt ook op world=simple.</comment>
    <statement name="STACK">
      <block type="dcMotor_setProperty_Direction" id="dirL">
        <field name="IDENTIFIER">leftDriveAsDcMotor</field>
        <field name="PROP">Direction</field>
        <data>{"IDENTIFIER":"leftDrive"}</data>
        <value name="VALUE">
          <shadow type="dcMotor_typedEnum_direction" id="dL"><field name="DIRECTION">FORWARD</field></shadow>
        </value>
        <next>
          <block type="dcMotor_setProperty_Direction" id="dirR">
            <field name="IDENTIFIER">rightDriveAsDcMotor</field>
            <field name="PROP">Direction</field>
            <data>{"IDENTIFIER":"rightDrive"}</data>
            <value name="VALUE">
              <shadow type="dcMotor_typedEnum_direction" id="dR"><field name="DIRECTION">REVERSE</field></shadow>
            </value>
            <next>
              <block type="linearOpMode_waitForStart" id="wfs">
                <next>
                  <block type="controls_whileUntil" id="loop">
                    <field name="MODE">WHILE</field>
                    <value name="BOOL">
                      <block type="linearOpMode_opModeIsActive" id="active"/>
                    </value>
                    <statement name="DO">
                      <block type="variables_set" id="setL">
                        <field name="VAR" id="varL">leftPow</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="negL">
                            <field name="OP">MINUS</field>
                            <value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow>
                              <block type="math_number" id="z0"><field name="NUM">0</field></block>
                            </value>
                            <value name="B">
                              <block type="gamepad_getProperty_Number" id="gyL">
                                <field name="IDENTIFIER">gamepad1</field>
                                <field name="PROP">LeftStickY</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="setR">
                            <field name="VAR" id="varR">rightPow</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="negR">
                                <field name="OP">MINUS</field>
                                <value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow>
                                  <block type="math_number" id="z1"><field name="NUM">0</field></block>
                                </value>
                                <value name="B">
                                  <block type="gamepad_getProperty_Number" id="gyR">
                                    <field name="IDENTIFIER">gamepad1</field>
                                    <field name="PROP">RightStickY</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="dcMotor_setDualProperty_Number" id="dualP">
                                <field name="PROP">Power</field>
                                <field name="IDENTIFIER1">leftDriveAsDcMotor</field>
                                <field name="IDENTIFIER2">rightDriveAsDcMotor</field>
                                <data>{"IDENTIFIER1":"leftDrive","IDENTIFIER2":"rightDrive"}</data>
                                <value name="VALUE1">
                                  <block type="variables_get" id="gL"><field name="VAR" id="varL">leftPow</field></block>
                                </value>
                                <value name="VALUE2">
                                  <block type="variables_get" id="gR"><field name="VAR" id="varR">rightPow</field></block>
                                </value>
                                <next>
                                  <block type="telemetry_addNumericData_Number" id="t1">
                                    <value name="KEY"><block type="text" id="k1"><field name="TEXT">L enc</field></block></value>
                                    <value name="NUMBER">
                                      <block type="dcMotor_getProperty_Number" id="eL">
                                        <field name="IDENTIFIER">leftDriveAsDcMotor</field>
                                        <field name="PROP">CurrentPosition</field>
                                        <data>{"IDENTIFIER":"leftDrive"}</data>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="telemetry_addNumericData_Number" id="t2">
                                        <value name="KEY"><block type="text" id="k2"><field name="TEXT">R enc</field></block></value>
                                        <value name="NUMBER">
                                          <block type="dcMotor_getProperty_Number" id="eR">
                                            <field name="IDENTIFIER">rightDriveAsDcMotor</field>
                                            <field name="PROP">CurrentPosition</field>
                                            <data>{"IDENTIFIER":"rightDrive"}</data>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="telemetry_update" id="tu"/>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml><?xml version='1.0' encoding='UTF-8' standalone='yes' ?><Extra><OpModeMeta flavor="TELEOP" group="Sim" /><Enabled value="true" /></Extra> 