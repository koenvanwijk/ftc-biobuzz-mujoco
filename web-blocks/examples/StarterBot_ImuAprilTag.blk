<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="varProc">myAprilTagProcessor</variable>
    <variable id="varPortal">myVisionPortal</variable>
    <variable id="varDets">detections</variable>
    <variable id="varYpr">ypr</variable>
  </variables>
  <block type="procedures_defnoreturn" id="run1" deletable="false" x="20" y="20">
    <field name="NAME">runOpMode</field>
    <comment pinned="false" h="80" w="480">Simulated IMU + AprilTag demo (BIOBUZZ). Init IMU &amp; vision once; loop telemeters yaw and detection count/id.</comment>
    <statement name="STACK">
      <block type="imu_initialize" id="imuInit">
        <field name="IDENTIFIER">imuAsIMU</field>
        <value name="PARAMETERS">
          <block type="imuParameters_create" id="imuParams">
            <value name="IMU_ORIENTATION_ON_ROBOT">
              <block type="revHubOrientationOnRobot_create1" id="revOri">
                <value name="LOGO_FACING_DIRECTION">
                  <block type="revHubOrientationOnRobot_typedEnum_logoFacingDirection" id="logo"><field name="LOGO_FACING_DIRECTION">UP</field></block>
                </value>
                <value name="USB_FACING_DIRECTION">
                  <block type="revHubOrientationOnRobot_typedEnum_usbFacingDirection" id="usb"><field name="USB_FACING_DIRECTION">FORWARD</field></block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="setProc">
            <field name="VAR" id="varProc">myAprilTagProcessor</field>
            <value name="VALUE">
              <block type="aprilTagProcessor_easyCreateWithDefaults" id="easyAt"/>
            </value>
            <next>
              <block type="variables_set" id="setPortal">
                <field name="VAR" id="varPortal">myVisionPortal</field>
                <value name="VALUE">
                  <block type="visionPortal_easyCreateWithDefaults_oneProcessor" id="easyVp">
                    <value name="CAMERA">
                      <block type="navigation_webcamName" id="cam"><field name="WEBCAM_NAME">Webcam 1</field></block>
                    </value>
                    <value name="VISION_PROCESSOR">
                      <block type="variables_get" id="getProc"><field name="VAR" id="varProc">myAprilTagProcessor</field></block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="linearOpMode_waitForStart" id="wfs">
                    <next>
                      <block type="controls_whileUntil" id="loop">
                        <field name="MODE">WHILE</field>
                        <value name="BOOL">
                          <block type="linearOpMode_opModeIsActive" id="active"/>
                        </value>
                        <statement name="DO">
                          <block type="variables_set" id="setYpr">
                            <field name="VAR" id="varYpr">ypr</field>
                            <value name="VALUE">
                              <block type="imu_getProperty_YawPitchRollAngles" id="getYpr">
                                <field name="IDENTIFIER">imuAsIMU</field>
                                <field name="PROP">RobotYawPitchRollAngles</field>
                              </block>
                            </value>
                            <next>
                              <block type="telemetry_addTextData_All" id="telYaw">
                                <value name="KEY"><shadow type="text" id="kYaw"><field name="TEXT">yawDeg</field></shadow><block type="text" id="kYaw2"><field name="TEXT">yawDeg</field></block></value>
                                <value name="TEXT">
                                  <block type="yawPitchRollAngles_getProperty_Number" id="yawNum">
                                    <field name="PROP">Yaw</field>
                                    <value name="YAW_PITCH_ROLL_ANGLES">
                                      <block type="variables_get" id="getYpr2"><field name="VAR" id="varYpr">ypr</field></block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="setDets">
                                    <field name="VAR" id="varDets">detections</field>
                                    <value name="VALUE">
                                      <block type="aprilTagProcessor_getDetections" id="getDets">
                                        <value name="APRIL_TAG_PROCESSOR">
                                          <block type="variables_get" id="getProc2"><field name="VAR" id="varProc">myAprilTagProcessor</field></block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="telemetry_addTextData_All" id="telLen">
                                        <value name="KEY"><block type="text" id="kLen"><field name="TEXT">aprilCount</field></block></value>
                                        <value name="TEXT">
                                          <block type="lists_length" id="listLen">
                                            <value name="VALUE">
                                              <block type="variables_get" id="getDets2"><field name="VAR" id="varDets">detections</field></block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="controls_if" id="ifDet">
                                            <value name="IF0">
                                              <block type="logic_compare" id="cmp">
                                                <field name="OP">GT</field>
                                                <value name="A">
                                                  <block type="lists_length" id="listLen2">
                                                    <value name="VALUE">
                                                      <block type="variables_get" id="getDets3"><field name="VAR" id="varDets">detections</field></block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="B"><block type="math_number" id="zero"><field name="NUM">0</field></block></value>
                                              </block>
                                            </value>
                                            <statement name="DO0">
                                              <block type="telemetry_addTextData_All" id="telId">
                                                <value name="KEY"><block type="text" id="kId"><field name="TEXT">firstId</field></block></value>
                                                <value name="TEXT">
                                                  <block type="aprilTagSingleDetection_getProperty_Number" id="detId">
                                                    <field name="PROP">id</field>
                                                    <value name="APRIL_TAG_SINGLE_DETECTION">
                                                      <block type="lists_getIndex" id="getFirst">
                                                        <mutation statement="false" at="true"/>
                                                        <field name="MODE">GET</field>
                                                        <field name="WHERE">FROM_START</field>
                                                        <value name="VALUE">
                                                          <block type="variables_get" id="getDets4"><field name="VAR" id="varDets">detections</field></block>
                                                        </value>
                                                        <value name="AT"><block type="math_number" id="one"><field name="NUM">1</field></block></value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="telemetry_update" id="telUp">
                                                <next>
                                                  <block type="linearOpMode_sleep" id="sleep">
                                                    <value name="MILLISECONDS">
                                                      <shadow type="math_number" id="ms"><field name="NUM">50</field></shadow>
                                                      <block type="math_number" id="ms2"><field name="NUM">50</field></block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml><?xml version='1.0' encoding='UTF-8' standalone='yes' ?><Extra><OpModeMeta flavor="TELEOP" group="Sim" /><Enabled value="true" /></Extra>
